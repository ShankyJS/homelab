# Managed by Ansible - do not edit manually
# k3s server configuration
# https://docs.k3s.io/installation/configuration

write-kubeconfig-mode: "{{ k3s_write_kubeconfig_mode }}"
{% if k3s_tls_san | length > 0 %}
tls-san:
{% for san in k3s_tls_san %}
  - "{{ san }}"
{% endfor %}
{% endif %}
{% if k3s_disable | length > 0 %}
disable:
{% for component in k3s_disable %}
  - {{ component }}
{% endfor %}
{% endif %}
flannel-backend: "{{ k3s_flannel_backend }}"
{% if k3s_disable_network_policy | default(false) %}
disable-network-policy: true
{% endif %}
{% if k3s_disable_kube_proxy | default(false) %}
disable-kube-proxy: true
{% endif %}
cluster-cidr: "{{ k3s_cluster_cidr }}"
service-cidr: "{{ k3s_service_cidr }}"
{% if k3s_extra_args %}
{{ k3s_extra_args }}
{% endif %}
